docker build -t roadmap:1.0 .
docker run --rm -p 8080:80 roadmap:1.0

aws ecr create-repository --repository-name roadmap
aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin URL-registro

docker images(ver imagenes creadas)

docker tag roadmap:1.0 url-registro
docker push url de registro:1.0