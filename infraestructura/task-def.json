{
    "family": "roadmap-task",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "roadmap-container",
            "image": "033113129691.dkr.ecr.us-east-1.amazonaws.com/roadmap:1.0",
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "essential": true
        }
    ],
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::033113129691:role/ecsTaskExecutionRole"
}